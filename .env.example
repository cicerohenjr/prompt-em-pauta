# Copie este arquivo para .env e preencha com seus dados da ElevenLabs.
# Nunca publique a chave de API nem envie a chave em mensagens.
ELEVENLABS_API_KEY=coloque_sua_chave_aqui
# Use o ID da voz The Professional Instructor selecionada na sua conta ElevenLabs.
ELEVENLABS_VOICE_ID=ID_DA_VOZ_THE_PROFESSIONAL_INSTRUCTOR
